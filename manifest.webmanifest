{
  "name": "EasyImage — ניהול תמונות",
  "short_name": "EasyImage",
  "id": "./",
  "description": "צפייה, עריכה, הדפסה וניהול מהיר של תמונות, ישירות בדפדפן.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0d1117",
  "theme_color": "#111827",
  "dir": "rtl",
  "lang": "he",
  "orientation": "any",
  "categories": ["photo", "productivity", "utilities"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "image/bmp": [".bmp"],
        "image/avif": [".avif"]
      }
    }
  ],
  "prefer_related_applications": false
}
