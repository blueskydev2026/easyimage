{
  "name": "ניהול תמונות",
  "short_name": "תמונות",
  "description": "צפייה וניהול מהיר של תמונות מקומיות.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "background_color": "#0d1117",
  "theme_color": "#111827",
  "dir": "rtl",
  "lang": "he",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": ".",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".avif"]
      }
    }
  ],
  "share_target": {
    "action": ".",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
