{
  "name": "EasyImage",
  "short_name": "EasyImage",
  "description": "צפייה, עריכה, ארגון והדפסה של תמונות באופן מקומי ופרטי.",
  "start_url": "/easyimage/",
  "scope": "/easyimage/",
  "display": "standalone",
  "background_color": "#15181d",
  "theme_color": "#15181d",
  "dir": "rtl",
  "lang": "he",
  "icons": [
    { "src": "/easyimage/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/easyimage/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/easyimage/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/easyimage/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "/easyimage/",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "image/bmp": [".bmp"],
        "image/avif": [".avif"]
      }
    }
  ],
  "categories": ["photo", "productivity", "utilities"]
}
